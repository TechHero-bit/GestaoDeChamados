NODE_ENV=development
PORT=3000

SUPABASE_URL=
SUPABASE_SECRET_KEY=

WEBHOOK_SECRET=

# Autenticação JWT e Sessão
# JWT_SECRET deve ter no mínimo 32 caracteres
JWT_SECRET=
JWT_COOKIE_NAME=helpdesk_session
COOKIE_SAME_SITE=lax

# Duração das sessões
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# CORS
FRONTEND_URL=http://localhost:4200
ALLOW_VERCEL_PREVIEWS=false

# Integração Power Automate
POWER_AUTOMATE_REPLY_URL=
POWER_AUTOMATE_REPLY_SECRET=

# Caixa corporativa usada nas mensagens registradas pelo Help Desk
HELPDESK_EMAIL=

# Rate Limiting Distribuído (Upstash Redis para produção Serverless Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Integração Microsoft OAuth / Microsoft Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://gestao-de-chamados-backend.vercel.app/api/integrations/microsoft/callback
# Segredo exclusivo para AES-256-GCM dos tokens Microsoft; nunca reutilizar JWT/WEBHOOK/Power Automate
MICROSOFT_TOKEN_ENCRYPTION_KEY=
